VITE_WHATSAPP_NUMBER=911234567890

# --- Local API server (server/) ---
# Port the Express API listens on. Vite's dev proxy forwards /api and
# /uploads here — set API_PORT too if you change this.
PORT=4000
# Any long random string — used to sign admin login sessions.
JWT_SECRET=replace-with-a-long-random-string
# The one admin account for this site. No self-signup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
